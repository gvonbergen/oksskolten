# No required environment variables for development.
# Service URLs (MEILI_URL, RSS_BRIDGE_URL, etc.) are set in compose.yaml.
#
# Optional overrides:
# JWT_SECRET=<string>           (default: auto-generated and stored in DB)
# LOG_LEVEL=debug               (default: info)
# TZ=Asia/Tokyo                 (default: UTC)
# AUTH_DISABLED=1               (requires NODE_ENV=development; server will refuse to start otherwise)
# SCORE_RECALC_SCHEDULE=0 3 * * *  (default: */5 * * * *; set to daily if event-driven covers all actions)
# VLLM_BASE_URL=http://host.docker.internal:8000
#
# Semantic search (embeddings) is configured in Settings -> Integration -> Semantic Search
# (settings table). Meilisearch calls back to the app through an internal embedding proxy
# whose token must stay stable across restarts, otherwise the managed embedder URL changes
# and Meilisearch re-embeds the whole index:
# EMBEDDING_PROXY_TOKEN=<string>  (development: auto-generated and persisted to .env on
#                                  first start when unset; production: set it explicitly)
#
# For a local Ollama embedding
# endpoint, Meilisearch must reach it — compose.yaml maps host.docker.internal via
# extra_hosts on Linux; on Docker Desktop it resolves automatically.
#
# Production (compose.prod.yaml):
# MEILI_MASTER_KEY=<string>     (required for production Meilisearch)
# EMBEDDING_PROXY_TOKEN=<string> (recommended in production: keeps the managed embedder URL
#                                stable across container restarts so no re-embedding happens)
# TUNNEL_TOKEN=<token>          (required for Cloudflare Tunnel)
# DATA_DIR=$HOME/.oksskolten/data   (default: ./data; set absolute path for prod)
# TURSO_AUTH_TOKEN=<token>      (only if using Turso instead of local SQLite)
